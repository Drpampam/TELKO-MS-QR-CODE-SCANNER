{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": [
            "FromLogContext"
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DataConnectionStrings": "Server=LAPTOP-IFV1VPAT;Database=TELKO-MS-EMPLOYEE-CONTACT-QRSCAN-DB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
    },
    "EmployeeContactDefaults": {
        "DefaultLinkedInUrl": "https://www.companywebsite.com"
    },
    "AppSettings": {
        "PathBase": "/BackEnd"
    }
}