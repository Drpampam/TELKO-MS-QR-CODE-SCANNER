@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Function to set up phone field functionality
            function setupPhoneField(countryCodeSelectId, phoneInputId) {
                const countryCodeSelect = document.getElementById(countryCodeSelectId);
                const phoneInput = document.getElementById(phoneInputId);

                // Function to clean and format phone number
                function cleanPhoneNumber(phoneNumber, countryCode) {
                    // Remove any existing country code from the beginning
                    phoneNumber = phoneNumber.replace(/^\+\d{1,4}\s*/, '');

                    // Remove leading zeros
                    phoneNumber = phoneNumber.replace(/^0+/, '');

                    // Remove any non-digit characters except spaces and dashes for readability
                    phoneNumber = phoneNumber.replace(/[^\d\s-]/g, '');

                    return phoneNumber;
                }

                // Function to update the phone field with country code
                function updatePhoneWithCountryCode() {
                    const countryCode = countryCodeSelect.value;
                    let phoneNumber = phoneInput.value;

                    phoneNumber = cleanPhoneNumber(phoneNumber, countryCode);

                    // Update the phone input value
                    phoneInput.value = countryCode + ' ' + phoneNumber;
                }

                // Listen for country code changes
                countryCodeSelect.addEventListener('change', updatePhoneWithCountryCode);

                // Initialize with default country code when page loads
                if (!phoneInput.value || !phoneInput.value.startsWith('+')) {
                    phoneInput.value = countryCodeSelect.value + ' ';
                }

                // Handle phone input changes to maintain country code and clean format
                phoneInput.addEventListener('input', function() {
                    const countryCode = countryCodeSelect.value;
                    let currentValue = phoneInput.value;

                    // If user somehow removed the country code, add it back
                    if (!currentValue.startsWith(countryCode)) {
                        let cleanNumber = cleanPhoneNumber(currentValue, countryCode);
                        phoneInput.value = countryCode + ' ' + cleanNumber;
                    } else {
                        // Clean the number part while maintaining country code
                        let numberPart = currentValue.substring(countryCode.length).trim();
                        let cleanNumber = cleanPhoneNumber(numberPart, countryCode);
                        phoneInput.value = countryCode + ' ' + cleanNumber;
                    }
                });

                // Clean phone number on form submission or when field loses focus
                phoneInput.addEventListener('blur', function() {
                    const countryCode = countryCodeSelect.value;
                    let currentValue = phoneInput.value;
                    let numberPart = currentValue.substring(countryCode.length).trim();
                    let cleanNumber = cleanPhoneNumber(numberPart, countryCode);
                    phoneInput.value = countryCode + ' ' + cleanNumber;
                });
            }

            // Set up both phone fields
            setupPhoneField('personalCountryCode', 'personalPhoneInput');
            setupPhoneField('workCountryCode', 'workPhoneInput');
        });
    </script>
