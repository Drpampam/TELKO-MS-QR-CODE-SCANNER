@page
@model WebUI.Pages.Contacts.QRCodeModel
@{
    ViewData["Title"] = "QR Code";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header container-section">
                    <h2 class="text-center text-white">QR Code</h2>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }
                    else if (Model.QRCodeBytes != null)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(Model.QRCodeBytes)"
                             alt="QR Code" class="img-fluid mb-3" style="max-width: 300px;" />
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            No QR code available.
                        </div>
                    }
                </div>

                <!-- Neatly aligned, deep blue buttons -->
                <div class="card-footer text-center">
                    <div class="d-flex justify-content-center flex-wrap gap-2">
                        <a href="@Url.Page("QRCode", "Download", new { phone = Request.Query["phone"] })"
                           class="btn btn-deepblue">
                            Download QR Code
                        </a>
                        <a asp-page="/Index" class="btn btn-deepblue">
                            Back to List
                        </a>
                        <a asp-page="/Contacts/Details" asp-route-phone="@Request.Query["phone"]" class="btn btn-deepblue">
                            View Details
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
@section Styles {
    <style>
        /* Deep Creamy Blue Header */
        .container-section {
            background-color: #001f3f; /* Deep creamy blue */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
    </style>
}