@page
@model IndexModel
@{
    ViewData["Title"] = "Employee Contacts";

    // Get uploaded phones from TempData (deserialize to list)
    var uploadedPhones = TempData["UploadedPhones"] != null
        ? System.Text.Json.JsonSerializer.Deserialize<List<string>>(TempData["UploadedPhones"].ToString()!)
        : new List<string>();
}

<div class="container mt-4">

    <div class="header-section d-flex justify-content-between align-items-center mb-4 p-3 rounded">
        <h2 class="header-title text-white">Employee Contacts</h2>
        <div class="d-flex align-items-center">
            <!-- File Upload Form -->
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" id="uploadForm">
                <div class="mb-3">
                    <input type="file" name="file" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary" id="uploadButton">
                    Upload
                </button>

                <div id="spinner" style="display:none; margin-top:10px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Uploading...</span>
                    </div>
                    Uploading...
                </div>
            </form>

            <!-- Existing Add New Contact Button -->
            <a asp-page="/Contacts/Create" class="btn btn-primary add-contact-btn">Add New Contact</a>
        </div>
    </div>

    <!-- ✅ Upload Success Message -->
    @if (TempData["UploadSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["UploadSuccess"]
        </div>
    }

    @if (TempData["UploadErrors"] != null)
    {
        var errors = TempData["UploadErrors"] as List<string>;
        if (errors != null && errors.Any())
        {
            <div class="alert alert-danger">
                <strong>Upload failed with the following errors:</strong>
                <ul>
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    }

    <!-- Filter Card -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <h6><label for="phone" class="form-label">Phone Number</label></h6>
                    <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone">
                </div>
                <div class="col-md-3">
                    <h6><label for="startDate" class="form-label">Start Date</label></h6>
                    <input type="date" class="form-control" id="startDate" name="startDate" value="@Model.StartDate">
                </div>
                <div class="col-md-3">
                    <h6><label for="endDate" class="form-label">End Date</label></h6>
                    <input type="date" class="form-control" id="endDate" name="endDate" value="@Model.EndDate">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary add-contact-btn">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered modern-table">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in Model.Contacts)
                {
                    // ✅ Highlight if phone is among newly uploaded
                    var isNewlyUploaded = uploadedPhones.Contains(contact.Phone);
                    var rowClass = isNewlyUploaded ? "clickable-row newly-uploaded" : "clickable-row";

                    <tr class="@rowClass" data-url="@Url.Page("/Contacts/Details", new { id = contact.Phone })">
                        <td>@contact.FullName</td>
                        <td>@contact.Phone</td>
                        <td>@contact.Email</td>
                        <td>@contact.Title</td>
                        <td>@contact.Company</td>
                        <td>
                            <div class="btn-group">
                                <a asp-page="/Contacts/Details" asp-route-phone="@contact.Phone" class="btn btn-sm btn-info">Details</a>
                                <a asp-page="/Contacts/QRCode" asp-route-phone="@contact.Phone" class="btn btn-sm btn-success">QR Code</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Clickable row logic
        document.querySelectorAll('.clickable-row').forEach(row => {
            row.addEventListener('click', () => {
                window.location = row.dataset.url;
            });
        });

        document.getElementById('uploadForm').addEventListener('submit', function () {
            // Show spinner
            document.getElementById('spinner').style.display = 'block';

            // Disable the upload button
            document.getElementById('uploadButton').disabled = true;

            // Optional: change button text
            document.getElementById('uploadButton').innerText = 'Uploading...';
        });
    </script>
}

